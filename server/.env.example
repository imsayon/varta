# Server Environment Configuration Example
PORT=5000
METRICS_PORT=5001
SERVICE_NAME=varta-api
LOG_LEVEL=info
NODE_ENV=development

# Database & Cache
# Runtime URL: raw libpq-compatible connection string without Prisma URL parameters.
DATABASE_URL=postgresql://varta:varta-local-postgres@localhost:5432/varta
# Prisma CLI/migrations only; the schema parameter is required.
DIRECT_URL=postgresql://varta:varta-local-postgres@localhost:5432/varta?schema=varta
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_PREFIX=varta

# Secrets & JWT (In production, ensure secrets are >= 32 characters)
JWT_ACCESS_SECRET=local-access-secret-change-me-32-chars
JWT_REFRESH_SECRET=local-refresh-secret-change-me-32-chars
JWT_WS_SECRET=local-websocket-secret-change-me-32-chars
METRICS_AUTH_TOKEN=local-metrics-token-change-me-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# OAuth (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/google/callback

# Client & Provider
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Varta <onboarding@resend.dev>

# AI (Optional)
AI_ENABLED=false
AI_PLATFORM_PROVIDER=gemini
AI_PLATFORM_API_KEY=

# Billing is fail-closed until explicitly enabled with matching Test or Live keys.
RAZORPAY_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_REQUEST_TIMEOUT_MS=5000
RAZORPAY_PLUS_PLAN_ID_INR=
RAZORPAY_BUSINESS_PLAN_ID_INR=
