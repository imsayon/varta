# === Server Configuration ===
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/varta

# === Redis ===
REDIS_URL=redis://localhost:6379

# === JWT ===
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# === OAuth (optional for local dev) ===
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/google/callback

# === Client ===
CLIENT_URL=http://localhost:3000

# === Email (Resend) ===
RESEND_API_KEY=
EMAIL_FROM=Varta <onboarding@resend.dev>

# === Auth Token TTLs ===
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
EMAIL_VERIFY_TOKEN_TTL_HOURS=24

# === AI (Phase 3) ===
ANTHROPIC_API_KEY=

# === Encryption ===
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
