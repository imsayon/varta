generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["varta"]
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String               @unique
  name                String?
  passwordHash        String?              @map("password_hash")
  emailVerified       Boolean              @default(false) @map("email_verified")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  oauthAccounts       OauthAccount[]
  emailVerifications  EmailVerification[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  workspaceMembers    WorkspaceMember[]
  billingAccounts     BillingAccount[]

  @@map("users")
  @@schema("varta")
}

model OauthAccount {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String
  providerUid String   @map("provider_uid")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("oauth_accounts")
  @@schema("varta")
}

model Session {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  userAgent     String?        @map("user_agent")
  ipAddress     String?        @map("ip_address")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
  @@schema("varta")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
  @@schema("varta")
}

model EmailVerification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
  @@schema("varta")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
  @@schema("varta")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER

  @@map("workspace_role")
  @@schema("varta")
}

model Workspace {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String                       @unique
  settings          Json?                        @default("{}")
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  members           WorkspaceMember[]
  apiKeys           ApiKey[]
  providerConfigs   ProviderConfig[]
  subscribers       Subscriber[]
  templates         Template[]
  routingRules      RoutingRule[]
  notifications     Notification[]
  pendingInApp      PendingInApp[]
  engagementEvents  EngagementEvent[]
  digestBatches     DigestBatch[]
  aiConfig          WorkspaceAiConfig?
  aiUsage           AiUsage[]
  engagementVectors SubscriberEngagementVector[]
  deliveries        Delivery[]
  outboxIntents     OutboxIntent[]

  billingWorkspaces BillingAccountWorkspace[]

  @@map("workspaces")
  @@schema("varta")
}

// --- Phase F2 Billing Models ---

model BillingAccount {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId        String                    @unique @map("owner_user_id") @db.Uuid
  razorpayCustomerId String?                   @unique @map("razorpay_customer_id")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  workspaces         BillingAccountWorkspace[]
  subscriptions      Subscription[]
  usageLedger        UsageLedger[]
  snapshots          EntitlementSnapshot[]
  auditEvents        BillingAuditEvent[]
  owner              User                      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@map("billing_accounts")
  @@schema("varta")
}

model BillingAccountWorkspace {
  billingAccountId String         @map("billing_account_id") @db.Uuid
  workspaceId      String         @unique @map("workspace_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([billingAccountId, workspaceId])
  @@map("billing_account_workspaces")
  @@schema("varta")
}

enum SubscriptionState {
  PENDING
  ACTIVE
  GRACE
  PAUSED
  CANCELLED
  EXPIRED

  @@map("subscription_state")
  @@schema("varta")
}

model Subscription {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billingAccountId       String            @map("billing_account_id") @db.Uuid
  planId                 String            @map("plan_id")
  planVersion            String            @map("plan_version")
  status                 SubscriptionState @default(PENDING)
  razorpaySubscriptionId String?           @unique @map("razorpay_subscription_id")
  checkoutOperationId    String?           @unique @map("checkout_operation_id")
  currentPeriodStart     DateTime?         @map("current_period_start") @db.Timestamptz
  currentPeriodEnd       DateTime?         @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd      Boolean           @default(false) @map("cancel_at_period_end")
  graceExpiresAt         DateTime?         @map("grace_expires_at") @db.Timestamptz
  providerStatus         String?           @map("provider_status")
  providerUpdatedAt      DateTime?         @map("provider_updated_at") @db.Timestamptz
  lastEventId            String?           @map("last_event_id")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  billingAccount         BillingAccount    @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId, status])
  @@map("subscriptions")
  @@schema("varta")
}

enum BillingWebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  IGNORED
  FAILED

  @@map("billing_webhook_status")
  @@schema("varta")
}

model BillingWebhookEvent {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String               @unique @map("event_id")
  eventType         String               @map("event_type")
  payloadCiphertext String               @map("payload_ciphertext")
  payloadHash       String               @map("payload_hash")
  signatureHash     String               @map("signature_hash")
  status            BillingWebhookStatus @default(PENDING)
  attempts          Int                  @default(0)
  availableAt       DateTime             @default(now()) @map("available_at") @db.Timestamptz
  claimedAt         DateTime?            @map("claimed_at") @db.Timestamptz
  leaseUntil        DateTime?            @map("lease_until") @db.Timestamptz
  providerCreatedAt DateTime?            @map("provider_created_at") @db.Timestamptz
  errorCode         String?              @map("error_code")
  errorMessage      String?              @map("error_message")
  processedAt       DateTime?            @map("processed_at") @db.Timestamptz
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, availableAt])
  @@index([eventType, status])
  @@map("billing_webhook_events")
  @@schema("varta")
}

enum UsageLedgerKind {
  NOTIFICATION_RESERVATION
  NOTIFICATION_COMPENSATION
  AI_RESERVATION
  AI_COMPENSATION

  @@map("usage_ledger_kind")
  @@schema("varta")
}

model UsageLedger {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billingAccountId String          @map("billing_account_id") @db.Uuid
  workspaceId      String?         @map("workspace_id") @db.Uuid
  operationId      String          @unique @map("operation_id")
  kind             UsageLedgerKind @default(NOTIFICATION_RESERVATION)
  deltaUnits       Int             @map("delta_units")
  balanceAfter     Int             @map("balance_after")
  periodStart      DateTime        @map("period_start") @db.Timestamptz
  periodEnd        DateTime        @map("period_end") @db.Timestamptz
  description      String?
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  billingAccount   BillingAccount  @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId, kind, periodStart])
  @@map("usage_ledger")
  @@schema("varta")
}

model EntitlementSnapshot {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billingAccountId       String         @map("billing_account_id") @db.Uuid
  planId                 String         @map("plan_id")
  planVersion            String         @map("plan_version")
  sourceEventId          String?        @map("source_event_id")
  canAcceptNotifications Boolean        @map("can_accept_notifications")
  canAccessAi            Boolean        @map("can_access_ai")
  limitsJson             Json           @map("limits_json")
  snapshotAt             DateTime       @default(now()) @map("snapshot_at") @db.Timestamptz
  billingAccount         BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId, snapshotAt])
  @@map("entitlement_snapshots")
  @@schema("varta")
}

model BillingAuditEvent {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billingAccountId String         @map("billing_account_id") @db.Uuid
  action           String
  actorType        String         @map("actor_type")
  actorId          String?        @map("actor_id")
  sourceEventId    String?        @map("source_event_id")
  details          Json           @default("{}")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId, createdAt])
  @@index([sourceEventId])
  @@map("billing_audit_events")
  @@schema("varta")
}

model WorkspaceAiConfig {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @unique @map("workspace_id") @db.Uuid
  provider        String
  model           String
  encryptedApiKey String    @map("encrypted_api_key")
  baseUrl         String?   @map("base_url")
  isEnabled       Boolean   @default(true) @map("is_enabled")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_ai_configs")
  @@schema("varta")
}

model AiUsage {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  provider      String
  model         String
  inputTokens   Int?      @map("input_tokens")
  outputTokens  Int?      @map("output_tokens")
  latencyMs     Int?      @map("latency_ms")
  promptVersion String?   @map("prompt_version")
  requestId     String?   @map("request_id")
  status        String
  errorCategory String?   @map("error_category")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, requestId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, provider, model])
  @@map("ai_usage")
  @@schema("varta")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_members")
  @@schema("varta")
}

model ApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  prefix      String    @unique
  keyHash     String    @map("key_hash")
  permissions Json?
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_keys")
  @@schema("varta")
}

model ProviderConfig {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  channel     String
  provider    String
  config      Json
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channel])
  @@map("provider_configs")
  @@schema("varta")
}

model Subscriber {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                      @map("workspace_id") @db.Uuid
  externalId       String                      @map("external_id")
  email            String?
  name             String?
  timezone         String?                     @default("UTC")
  locale           String?                     @default("en")
  attributes       Json?                       @default("{}")
  preferences      Json?                       @default("{}")
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  workspace        Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notifications    Notification[]
  engagements      EngagementEvent[]
  pendingInApp     PendingInApp[]
  digestBatches    DigestBatch[]
  engagementVector SubscriberEngagementVector?

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
  @@index([workspaceId, email])
  @@map("subscribers")
  @@schema("varta")
}

model Template {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  name          String
  description   String?
  channels      Json
  digestConfig  Json?          @map("digest_config")
  aiPersonalize Boolean?       @default(false) @map("ai_personalize")
  isActive      Boolean?       @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notifications Notification[]
  digestBatches DigestBatch[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("templates")
  @@schema("varta")
}

model RoutingRule {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  name            String
  naturalLanguage String?   @map("natural_language")
  ruleAst         Json      @map("rule_ast")
  priority        Int       @default(0)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, priority])
  @@map("routing_rules")
  @@schema("varta")
}

enum NotificationStatus {
  PENDING
  ENQUEUED
  PARTIAL
  DELIVERED
  FAILED

  @@map("notification_status")
  @@schema("varta")
}

enum DeliveryStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  DLQ

  @@map("delivery_status")
  @@schema("varta")
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH

  @@schema("varta")
}

model Notification {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String               @map("workspace_id") @db.Uuid
  templateId           String               @map("template_id") @db.Uuid
  subscriberId         String               @map("subscriber_id") @db.Uuid
  idempotencyKey       String               @map("idempotency_key")
  triggerPayload       Json?                @default("{}") @map("trigger_payload")
  channels             String[]
  status               NotificationStatus   @default(PENDING)
  priority             NotificationPriority @default(NORMAL)
  smartTimingRequested Boolean              @default(false) @map("smart_timing_requested")
  scheduledAt          DateTime?            @map("scheduled_at") @db.Timestamptz
  readAt               DateTime?            @map("read_at") @db.Timestamptz
  triggeredAt          DateTime?            @default(now()) @map("triggered_at") @db.Timestamptz
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template             Template             @relation(fields: [templateId], references: [id])
  subscriber           Subscriber           @relation(fields: [subscriberId], references: [id])
  deliveryAttempts     DeliveryAttempt[]
  deliveries           Delivery[]
  engagements          EngagementEvent[]
  pendingInApp         PendingInApp[]
  digestAggregateBatch DigestBatch?         @relation("DigestAggregateNotification")
  digestSourceItems    DigestBatchItem[]    @relation("DigestSourceNotification")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([templateId])
  @@index([subscriberId])
  @@index([status])
  @@index([workspaceId, readAt])
  @@map("notifications")
  @@schema("varta")
}

model Delivery {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  notificationId    String            @map("notification_id") @db.Uuid
  channel           String
  status            DeliveryStatus    @default(PENDING)
  provider          String?
  providerMessageId String?           @map("provider_message_id")
  scheduledAt       DateTime?         @map("scheduled_at") @db.Timestamptz
  lastError         String?           @map("last_error")
  leaseOwner        String?           @map("lease_owner")
  leaseUntil        DateTime?         @map("lease_until") @db.Timestamptz
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notification      Notification      @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  attempts          DeliveryAttempt[]
  outboxIntent      OutboxIntent?

  @@unique([notificationId, channel])
  @@index([workspaceId, status])
  @@index([status, scheduledAt])
  @@index([status, leaseUntil])
  @@map("deliveries")
  @@schema("varta")
}

enum OutboxStatus {
  PENDING
  LEASED
  PUBLISHED
  FAILED

  @@map("outbox_status")
  @@schema("varta")
}

model OutboxIntent {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  deliveryId  String       @unique @map("delivery_id") @db.Uuid
  eventType   String       @map("event_type")
  payload     Json         @default("{}")
  status      OutboxStatus @default(PENDING)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz
  leaseOwner  String?      @map("lease_owner")
  leaseUntil  DateTime?    @map("lease_until") @db.Timestamptz
  attempts    Int          @default(0)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  delivery    Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([leaseUntil])
  @@index([workspaceId])
  @@map("outbox_intents")
  @@schema("varta")
}

model DeliveryAttempt {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String          @map("notification_id") @db.Uuid
  channel           String
  attemptNumber     Int             @map("attempt_number")
  deliveryId        String          @map("delivery_id") @db.Uuid
  status            DeliveryStatus? @default(PENDING)
  provider          String?
  providerMessageId String?         @map("provider_message_id")
  renderedContent   Json?           @map("rendered_content")
  providerResponse  Json?           @map("provider_response")
  errorMessage      String?         @map("error_message")
  enqueuedAt        DateTime?       @map("enqueued_at") @db.Timestamptz
  startedAt         DateTime?       @map("started_at") @db.Timestamptz
  finishedAt        DateTime?       @map("finished_at") @db.Timestamptz
  durationMs        Int?            @map("duration_ms")
  notification      Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  delivery          Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([notificationId])
  @@index([status])
  @@index([notificationId, channel, deliveryId])
  @@map("delivery_attempts")
  @@schema("varta")
}

model ProviderWebhookEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String
  eventId           String   @map("event_id")
  eventType         String   @map("event_type")
  providerMessageId String?  @map("provider_message_id")
  payloadHash       String   @map("payload_hash")
  matchedAttemptId  String?  @map("matched_attempt_id") @db.Uuid
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@unique([provider, eventId])
  @@index([providerMessageId])
  @@map("provider_webhook_events")
  @@schema("varta")
}

enum DigestBatchStatus {
  OPEN
  PROCESSING
  DELIVERED
  FAILED

  @@map("digest_batch_status")
  @@schema("varta")
}

model DigestBatch {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String            @map("workspace_id") @db.Uuid
  subscriberId            String            @map("subscriber_id") @db.Uuid
  templateId              String            @map("template_id") @db.Uuid
  channel                 String
  aggregationKey          String            @map("aggregation_key")
  windowStartedAt         DateTime          @map("window_started_at") @db.Timestamptz
  windowExpiresAt         DateTime          @map("window_expires_at") @db.Timestamptz
  status                  DigestBatchStatus @default(OPEN)
  claimedBy               String?           @map("claimed_by")
  claimedAt               DateTime?         @map("claimed_at") @db.Timestamptz
  leaseUntil              DateTime?         @map("lease_until") @db.Timestamptz
  aggregateNotificationId String?           @unique @map("aggregate_notification_id") @db.Uuid
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  workspace               Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriber              Subscriber        @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  template                Template          @relation(fields: [templateId], references: [id])
  aggregateNotification   Notification?     @relation("DigestAggregateNotification", fields: [aggregateNotificationId], references: [id])
  items                   DigestBatchItem[]

  @@index([workspaceId, status, windowExpiresAt])
  @@index([aggregationKey, status])
  @@index([subscriberId])
  @@index([templateId])
  @@map("digest_batches")
  @@schema("varta")
}

model DigestBatchItem {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId              String       @map("batch_id") @db.Uuid
  sourceNotificationId String       @map("source_notification_id") @db.Uuid
  channel              String
  content              Json
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  batch                DigestBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceNotification   Notification @relation("DigestSourceNotification", fields: [sourceNotificationId], references: [id], onDelete: Cascade)

  @@unique([batchId, sourceNotificationId, channel])
  @@index([sourceNotificationId])
  @@map("digest_batch_items")
  @@schema("varta")
}

model PendingInApp {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  subscriberId   String       @map("subscriber_id") @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  content        Json
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  deliveredAt    DateTime?    @map("delivered_at") @db.Timestamptz
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriber     Subscriber   @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId])
  @@index([workspaceId, subscriberId, deliveredAt])
  @@index([subscriberId])
  @@map("pending_inapp")
  @@schema("varta")
}

model EngagementEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  subscriberId   String       @map("subscriber_id") @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  eventType      String       @map("event_type")
  channel        String
  occurredAt     DateTime?    @default(now()) @map("occurred_at") @db.Timestamptz
  metadata       Json?        @default("{}")
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriber     Subscriber   @relation(fields: [subscriberId], references: [id])
  notification   Notification @relation(fields: [notificationId], references: [id])

  @@index([workspaceId])
  @@index([subscriberId, eventType])
  @@index([notificationId])
  @@index([occurredAt])
  @@map("engagement_events")
  @@schema("varta")
}

model SubscriberEngagementVector {
  subscriberId String                     @id @map("subscriber_id") @db.Uuid
  workspaceId  String                     @map("workspace_id") @db.Uuid
  embedding    Unsupported("vector(24)")?
  sampleCount  Int                        @default(0) @map("sample_count")
  computedAt   DateTime                   @default(now()) @map("computed_at") @db.Timestamptz
  workspace    Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriber   Subscriber                 @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("subscriber_engagement_vectors")
  @@schema("varta")
}
