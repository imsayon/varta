{
	"name": "@varta/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": "24.18.0",
		"pnpm": "11.20.0"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:worker": "tsx watch src/worker.ts",
		"build": "tsup src/server.ts src/worker.ts src/combined.ts --format esm --out-dir dist --target node24 --sourcemap --clean --tsconfig tsconfig.json",
		"start": "node dist/server.js",
		"start:worker": "node dist/worker.js",
		"start:combined": "node dist/combined.js",
		"lint": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"test": "DATABASE_URL=${DATABASE_URL:-postgresql://localhost/test} REDIS_URL=${REDIS_URL:-redis://localhost:6379} JWT_ACCESS_SECRET=${JWT_ACCESS_SECRET:-test} JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET:-test} JWT_WS_SECRET=${JWT_WS_SECRET:-test} NODE_ENV=test tsx --test --experimental-test-coverage --test-coverage-lines=65 --test-coverage-branches=70 --test-coverage-functions=45 --test-concurrency=1 $(find src -type f -name '*.test.ts' -print)",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:deploy": "prisma migrate deploy",
		"prisma:push": "prisma db push",
		"prisma:studio": "prisma studio",
		"prisma:seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/exporter-trace-otlp-http": "0.221.0",
		"@opentelemetry/instrumentation-express": "0.69.0",
		"@opentelemetry/instrumentation-http": "0.221.0",
		"@opentelemetry/sdk-node": "0.221.0",
		"@prisma/adapter-pg": "7.9.1",
		"@prisma/client": "7.9.1",
		"argon2": "0.45.1",
		"bullmq": "6.0.7",
		"compression": "1.8.1",
		"cookie-parser": "1.4.7",
		"cors": "2.8.6",
		"dotenv": "17.4.2",
		"express": "5.2.1",
		"express-rate-limit": "8.6.2",
		"handlebars": "4.7.9",
		"helmet": "8.3.0",
		"ioredis": "6.0.0",
		"isomorphic-dompurify": "3.21.0",
		"jose": "6.2.8",
		"nanoid": "6.0.1",
		"passport": "0.7.0",
		"passport-github2": "0.1.12",
		"passport-google-oauth20": "2.0.0",
		"pg": "8.22.0",
		"pino": "10.3.1",
		"pino-http": "11.0.0",
		"prom-client": "15.1.3",
		"rate-limiter-flexible": "11.2.0",
		"resend": "6.18.1",
		"slugify": "1.6.9",
		"ws": "8.21.2",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/compression": "1.8.1",
		"@types/cookie-parser": "1.4.10",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/node": "24.13.3",
		"@types/passport": "1.0.17",
		"@types/passport-github2": "1.2.9",
		"@types/passport-google-oauth20": "2.0.17",
		"@types/pg": "8.20.4",
		"@types/ws": "8.18.1",
		"pino-pretty": "13.1.3",
		"prisma": "7.9.1",
		"tsup": "8.5.1",
		"tsx": "4.23.5",
		"typescript": "7.0.2"
	}
}
