  "panels": [
    {
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "HTTP Request Rate by Status",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(varta_http_requests_total[5m])) by (status_class)",
          "legendFormat": "HTTP {{status_class}}"
        }
      ]
    },
    {
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Queue Backlog Jobs",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "varta_queue_jobs{state=\"waiting\"}",
          "legendFormat": "{{queue}} waiting"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Notification Acceptance",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(varta_notification_acceptance_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "Delivery Outcomes",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(varta_delivery_attempts_total[5m])) by (channel, outcome)",
          "legendFormat": "{{channel}} {{outcome}}"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "title": "Outbox and Queue Age",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "varta_outbox_oldest_eligible_seconds",
          "legendFormat": "outbox"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "varta_queue_oldest_job_seconds",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "title": "Dependency and Pool Health",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "varta_dependency_ready",
          "legendFormat": "{{dependency}} ready"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "varta_database_pool_connections",
          "legendFormat": "pool {{state}}"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "title": "Realtime Connections and Events",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "varta_ws_connections_active",
          "legendFormat": "connections"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(varta_realtime_events_total[5m])) by (event, outcome)",
          "legendFormat": "{{event}} {{outcome}}"
        }
      ]
