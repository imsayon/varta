# Compose interpolation and local-only credentials. Never use this file for production.
POSTGRES_DB=varta
POSTGRES_USER=varta
POSTGRES_PASSWORD=varta-local-postgres-pass-32-char
REDIS_PASSWORD=varta-local-redis-password-32-char
JWT_ACCESS_SECRET=local-access-secret-change-me-32-chars
JWT_REFRESH_SECRET=local-refresh-secret-change-me-32-chars
JWT_WS_SECRET=local-websocket-secret-change-me-32-chars
METRICS_AUTH_TOKEN=local-metrics-token-change-me-32-chars
METRICS_AUTH_TOKEN_FILE=ops/env/local.metrics.token
ENCRYPTION_KEY=local-encryption-key-change-me-000
HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=varta-local-grafana
OTEL_ENABLED=false
DOMAIN=localhost
